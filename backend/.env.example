PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/luxedrive?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
NODE_ENV=production

# Midtrans Configuration (Settings -> Access Keys in Midtrans Dashboard)
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_KEY
MIDTRANS_IS_PRODUCTION=false
